name: Claude PR Review

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write
  issues: write

concurrency:
  group: claude-review-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    if: ${{ !github.event.pull_request.draft && github.event.pull_request.head.repo.full_name == github.repository }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Check for Claude credentials
        id: credentials
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        run: |
          if [ -n "$ANTHROPIC_API_KEY" ] || [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
            echo "available=true" >> "$GITHUB_OUTPUT"
          else
            echo "available=false" >> "$GITHUB_OUTPUT"
            echo "::notice::No ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN secret is set; skipping the review."
          fi

      - name: Check out the pull request
        if: steps.credentials.outputs.available == 'true'
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Review with Claude
        if: steps.credentials.outputs.available == 'true'
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          github_token: ${{ github.token }}
          prompt: |
            REPO: ${{ github.repository }}
            PR NUMBER: ${{ github.event.pull_request.number }}

            Review this pull request. The PR branch is checked out, and the base
            branch is available as origin/${{ github.event.pull_request.base.ref }};
            `gh pr diff` also works.

            This job runs on Linux, and this repository is a Swift package plus a
            macOS/iOS SwiftUI app. Do not build, run tests, or install toolchains:
            no xcodebuild, no swift build, no swift test, no Tests/e2e.sh. Review
            only by reading the diff and the code around it, and do not claim the
            project does or does not compile.

            Read AGENTS.md first and review against it, especially:
            - Layering: view files hold only disposable state, view models hold the
              minimal state and behavior, the controller holds the data management
              and logic, and access/remote layers stay out of the app and CLI. New
              logic belongs in Sources/CsumController, not in the view or the CLI.
            - Member access is private unless there is a reason for more.
            - Functions that do something have verbal names.
            - No comments in any file. Do not suggest adding code comments.
            - Blank lines before and after do, if, and switch blocks, except at the
              start or end of the enclosing block or function.
            - No lines repeated across switch cases.

            Also review for:
            - Correctness and edge cases: empty and unreadable files, unusual or
              non-UTF-8 paths, very large files, truncated reads, checksum
              failures, mismatched algorithms, moved roots, relative paths.
            - Streaming and memory behavior in the controller's 1 MB chunked reads.
            - Error handling: thrown errors versus failure codes in the CSV, exit
              codes in the CLI, and messages on stderr.
            - The .csum.csv format: header comment lines, RFC 4180 quoting, CRLF
              line endings and UTF-8 BOM on write, tolerant reading, round trips.
            - Test coverage in Tests/ for the behavior that changed.
            - README and plans/ still matching the behavior that changed.
            - Security and privacy: no secrets, no force unwraps or fatalErrors on
              input-driven paths, no unsafe path handling.

            Do not restate the diff, do not nitpick style AGENTS.md does not ask
            for, and do not critique the CI configuration unless it is actually
            broken.

            Post exactly one summary comment with `gh pr comment`. Lead with a one
            line verdict, then findings ordered by severity, each with file:line.
            Use mcp__github_inline_comment__create_inline_comment (with
            confirmed: true) for findings that belong on a specific line. If the
            PR has no substantive problems, say so in one sentence instead of
            inventing issues.
          claude_args: |
            --max-turns 40
            --allowedTools "Read,Grep,Glob,Bash(gh pr view:*),Bash(gh pr diff:*),Bash(gh pr comment:*),Bash(git diff:*),Bash(git log:*),Bash(git show:*),mcp__github_inline_comment__create_inline_comment"
