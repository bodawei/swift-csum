    "Folder" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾"
          }
        }
      }
    },
    "For a .csum.csv the page shows when it was computed, the algorithm, the root the paths are relative to, and every row. For a .csum-compare.csv it shows the rows exactly as the file has them, with the # comment lines in the first column." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في ملف ‎.csum.csv تُظهر الصفحة وقت الحساب والخوارزمية والجذر الذي تُنسب إليه المسارات وكل صف. وفي ملف ‎.csum-compare.csv تُعرض الصفوف كما هي في الملف تمامًا، مع أسطر التعليقات ‎# في العمود الأول."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若是 .csum.csv，頁面會顯示計算時間、演算法、路徑所相對的根目錄，以及每一列。若是 .csum-compare.csv，則完全依照檔案內容顯示各列，並將 # 註解行放在第一欄。"
          }
        }
      }
    },
